# ==========================================================
# AI Studio Runtime
# ==========================================================
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# ==========================================================
# Firebase Admin SDK (Vercel / Servidor - NUNCA expor no front-end)
# ==========================================================
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_DATABASE_ID="(default)"

# ==========================================================
# Firebase Web SDK (Front-end público Vite - opcional na AI Studio,
# pois firebase-applet-config.json já é carregado como padrão)
# ==========================================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""

# ==========================================================
# Cron & Notificações (Opcional)
# ==========================================================
CRON_SECRET=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Oficio & Medida <no-reply@seu-dominio.com>"
